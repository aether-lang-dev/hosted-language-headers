// Builds hosttinygo.ae and runs it. The program loads a Go library at run time,
// so this node dep()s the greet/ node first: that one compiles greet.go to
// libgreet.so, and this one then compiles and runs the program that loads it.
// (The library gets its own subdirectory because aeb keys a module on its
// directory, so two builder nodes cannot share one.) aether.program_test
// compiles the program and runs it, which is what makes the Go functions run.
import bldr
import aether

aeb(cap) {
    bldr.build() {
        dep("greet/.greet.ae")
        aether.program_test() {
            source("hosttinygo.ae")
        }
    }
}
