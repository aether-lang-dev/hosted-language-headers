// Readiness: an Aether program calling into Go. The Go library is compiled to
// libgreet.so by the greet/ node (see .build.ae) and loaded here by path; its
// exported functions are called directly, in this process, with no IPC. The
// bridge comes from the aether-guest-languages package (`import tinygo`, see
// aether.toml). Prints "hello from tinygo, hosted by aether" and the two
// results, Add(2,40)=42 and Answer()=42.
//
//   cd hosttinygo && aeb .build.ae
//
// The path below is where aeb puts the greet/ node's output, relative to the
// directory the test runs in (the project root, hosttinygo/). A failed load
// exits 1, so program_test reports it instead of passing.

import tinygo

main() {
    so = "target/greet/greet/lib/libgreet.so"

    handle, err = tinygo.load(so)
    if handle == null {
        println("FAIL: tinygo.load(${so}): ${err}")
        exit(1)
    }

    answer = tinygo.call_int_void(handle, "Answer")
    sum = tinygo.call_int_int_int(handle, "Add", 2, 40)

    println("hello from tinygo, hosted by aether")
    println("Add(2,40)=${sum}  Answer()=${answer}")
    if sum != 42 || answer != 42 { exit(1) }

    tinygo.unload(handle)
}
