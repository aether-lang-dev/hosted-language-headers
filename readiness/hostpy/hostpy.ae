// Readiness: an Aether program running Python. The python bridge comes from the
// aether-guest-languages package (`import python`, see aether.toml). It is
// compiled into this program and loads the machine's Python library at run
// time, so the program builds with no Python dev package. If the library is not
// found by the bridge's default search, set AETHER_PYTHON_SONAME to its exact soname or
// path. Prints "hello from python, hosted by aether".
//
//   cd hostpy && aeb .build.ae

import python

main() {
    rc = python.run("print('hello from python, hosted by aether')")
    python.finalize()
    if rc != 0 { exit(1) }
}
