// Readiness: an Aether program running Ruby. The ruby bridge comes from the
// aether-guest-languages package (`import ruby`, see aether.toml). It is
// compiled into this program and loads the machine's Ruby library at run
// time, so the program builds with no Ruby dev package. If the library is not
// found by the bridge's default search, set AETHER_RUBY_SONAME to its exact soname or
// path. Prints "hello from ruby, hosted by aether".
//
//   cd hostruby && aeb .build.ae

import ruby

main() {
    rc = ruby.run("puts 'hello from ruby, hosted by aether'")
    // Ruby's teardown is finalize_host, not finalize; call it once, last.
    ruby.finalize_host()
    if rc != 0 { exit(1) }
}
