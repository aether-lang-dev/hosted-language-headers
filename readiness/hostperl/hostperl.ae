// Readiness: an Aether program running Perl. The perl bridge comes from the
// aether-guest-languages package (`import perl`, see aether.toml). It is
// compiled into this program and loads the machine's Perl library at run
// time, so the program builds with no Perl dev package. If the library is not
// found by the bridge's default search, set AETHER_PERL_SONAME to its exact soname or
// path. Prints "hello from perl, hosted by aether".
//
//   cd hostperl && aeb .build.ae

import perl

main() {
    rc = perl.run("print \"hello from perl, hosted by aether\\n\"")
    perl.finalize()
    if rc != 0 { exit(1) }
}
