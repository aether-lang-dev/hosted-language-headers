// The Go library node: aether.tinygo_lib compiles greet.go to a c-shared
// library, libgreet.so. The name says tinygo, but aeb builds it with the
// standard Go toolchain (`go build -buildmode=c-shared`, cgo and a C compiler
// needed), because TinyGo's c-shared mode supports only wasm. The output lands
// in target/build/hosttinygo/greet/lib/ and hosttinygo.ae loads it by that path.
import bldr
import aether

aeb(cap) {
    bldr.build() {
        aether.tinygo_lib() {
            go_source("greet.go")
            output("libgreet.so")
        }
    }
}
