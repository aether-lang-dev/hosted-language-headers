// Readiness: an Aether program running Tcl. The tcl bridge comes from the
// aether-guest-languages package (`import tcl`, see aether.toml). It is
// compiled into this program and loads the machine's Tcl library at run
// time, so the program builds with no Tcl dev package. If the library is not
// found by the bridge's default search, set AETHER_TCL_SONAME to its exact soname or
// path. Prints "hello from tcl, hosted by aether".
//
//   cd hosttcl && aeb .build.ae

import tcl

main() {
    rc = tcl.run("puts \"hello from tcl, hosted by aether\"")
    tcl.finalize()
    if rc != 0 { exit(1) }
}
