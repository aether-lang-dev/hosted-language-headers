// Readiness: an Aether program running Lua. The lua bridge comes from the
// aether-guest-languages package (`import lua`, see aether.toml). It is
// compiled into this program and loads the machine's Lua library at run
// time, so the program builds with no Lua dev package. If the library is not
// found by the bridge's default search, set AETHER_LUA_SONAME to its exact soname or
// path. Prints "hello from lua, hosted by aether".
//
//   cd hostlua && aeb .build.ae

import lua

main() {
    rc = lua.run("print('hello from lua, hosted by aether')")
    lua.finalize()
    if rc != 0 { exit(1) }
}
