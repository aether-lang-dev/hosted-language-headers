// app target — the DAG root. Deps on the greeter leaf (dep, the greppable
// edge) and imports its source module. aeb topo-sorts: greeter builds first,
// then app. Readiness Test 2's root; running ./app proves the whole
// multi-node aeb DAG resolved in-container.

import bldr
import aether

aeb(cap) {
    bldr.build() {
        dep("greeter/.build.ae")
        aether.program() {
            source("app.ae")
        }
    }
}
