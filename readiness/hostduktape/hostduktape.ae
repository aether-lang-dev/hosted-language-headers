// Readiness: an Aether program running JavaScript (Duktape). The duktape bridge comes from the
// aether-guest-languages package (`import duktape`, see aether.toml). It is
// compiled into this program and loads the machine's JavaScript (Duktape) library at run
// time, so the program builds with no JavaScript (Duktape) dev package. If the library is not
// found by the bridge's default search, set AETHER_DUKTAPE_SONAME to its exact soname or
// path. Prints "hello from duktape, hosted by aether".
//
//   cd hostduktape && aeb .build.ae

import duktape

main() {
    rc = duktape.run("print('hello from duktape, hosted by aether')")
    duktape.finalize()
    if rc != 0 { exit(1) }
}
